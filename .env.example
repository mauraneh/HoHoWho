# Copy to .env and fill in. .env is git-ignored: never commit real values.
# Only PUBLIC values belong here. The anon/publishable key is designed to be exposed to browsers;
# data is protected by Row Level Security. NEVER put the service_role/secret key in this file.

# Supabase project URL (Project Settings → API), or http://127.0.0.1:54321 for `supabase start`.
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon / publishable key (Project Settings → API).
SUPABASE_ANON_KEY=your-anon-key
